# ---------------------------------------------------------------------------
# Luactopus MCP Server configuration. Copy to .env (python -m luactopus_mcp setup does it).
# Relative paths are resolved from the project root.
# ---------------------------------------------------------------------------

# --- Server ----------------------------------------------------------------
MCP_SERVER_NAME=Luactopus
# stdio (Claude Desktop / Claude Code / Cursor launch the server) | streamable-http | sse
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8765
MCP_HTTP_PATH=/mcp
# Extra Host headers accepted over HTTP when exposing the server (comma separated), e.g. myhost:8765
MCP_ALLOWED_HOSTS=

# --- Protected Mode ---------------------------------------------------------
# false (default): no API key needed.
# true: an API key is required. The first start creates one automatically, stores its hash in
#       SQLite (DB_PATH) and shows it once (console + storage/FIRST_API_KEY.txt).
#       HTTP clients send:  Authorization: Bearer <key>   (or X-API-Key: <key>)
#       stdio clients set LUACTOPUS_API_KEY in the server's env in their MCP config.
PROTECTED_MODE=false
LUACTOPUS_API_KEY=

# --- Folders ------------------------------------------------------------------
TOOLS_DIR=./Tools
DATA_DIR=./Data
LOG_DIR=./logs
WORKSPACE_DIR=./workspace
STORAGE_DIR=./storage
DB_PATH=./storage/luactopus.db

# --- Runtimes (leave empty to auto-detect on PATH) ------------------------------
PYTHON_BIN=
NODE_BIN=
# Lua 5.3/5.4 - used by Goofyscator V10/V11 to capture the VM
LUA_BIN=
# Lune - used by the Oxygen env logger and Goofyscator V11 (lune engine)
LUNE_BIN=
# Folder with luau(.exe) + luau-ast(.exe). `setup` copies them into the Luraph tool's bin/.
# Empty = use Data/flowauth/vendor/luraph151/bin when it exists.
LUAU_DIR=

# --- Behaviour ------------------------------------------------------------------
DEFAULT_TIMEOUT=180
MAX_TIMEOUT=900
MAX_INPUT_BYTES=8388608
MAX_LAYERS=5
# Let the client AI fork + patch backends (copies in workspace/overrides; Tools/ is never modified)
ALLOW_TOOL_EDITS=true
# Let the client AI add new backends (workspace/custom_tools). This is code execution - keep it
# false on a shared/remote server.
ALLOW_CUSTOM_TOOLS=true
# Backends that execute the protected script in an emulated Roblox env (Luraph, IB1, Goofyscator,
# env logger). They are not security sandboxes: run untrusted scripts inside a VM/container.
ALLOW_DYNAMIC_BACKENDS=true
# Allow `file_path` arguments (reads files on the server machine). Defaults to true for stdio,
# false for HTTP.
ALLOW_LOCAL_PATHS=

# --- Logging ----------------------------------------------------------------------
LOG_LEVEL=INFO
# Max characters per logged field (full scripts are always kept in the job folder)
LOG_MAX_FIELD_CHARS=4000
